# Firebase Admin service account and database configuration
FIREBASE_KEY_PATH=./firebase-key.json
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_SENSOR_DATABASE_URL=https://your-sensor-project-default-rtdb.asia-southeast1.firebasedatabase.app
# Optional RTDB REST token when the sensor database requires authentication.
FIREBASE_SENSOR_AUTH_TOKEN=
# Legacy ESP32 timestamps are Sri Lanka local time. Age is a display indicator.
IOT_SENSOR_TIMEZONE=Asia/Colombo
IOT_STALE_AFTER_SECONDS=900

# Offline baseline; run python -m plant_condition.worker separately.
# Unset model directory uses backend/models/plant_condition.
# PLANT_CONDITION_MODEL_DIR=/absolute/path/to/baseline-artifact-folder
PLANT_CONDITION_SHADOW_MODE=true
PLANT_CONDITION_POLL_SECONDS=30

# ESP32 USB serial relay controller
ESP32_SERIAL_PORT=/dev/cu.usbserial-0001
ESP32_BAUD_RATE=115200

# Optional email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=CinnaAI Notifications

# Optional Gemini shadow verification (backend only)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_ENABLED=false
GEMINI_TIMEOUT_SECONDS=15

# Hybrid routing remains shadow-only in this implementation
HYBRID_SHADOW_MODE=true
HYBRID_SPECIALIST_CONFIDENCE_THRESHOLD=0.70
HYBRID_SPECIALIST_MARGIN_THRESHOLD=0.15
HYBRID_VERSION=hybrid-v1

# Gemini free-tier resilience and image safety
GEMINI_MAX_CONCURRENCY=2
GEMINI_CIRCUIT_FAILURE_THRESHOLD=3
GEMINI_CIRCUIT_COOLDOWN_SECONDS=120
GEMINI_IMAGE_MAX_DIMENSION=1600
GEMINI_CACHE_ENABLED=false

# Existing EfficientNet acceptance and upload controls
DISEASE_CONFIDENCE_THRESHOLD=0.70
DISEASE_MARGIN_THRESHOLD=0.15
FAISS_SIMILARITY_THRESHOLD=0.82
DISEASE_MAX_UPLOAD_MB=10
